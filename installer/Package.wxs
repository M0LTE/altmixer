<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- UpgradeCode must never change: it's how a new version finds and replaces the old one. -->
  <Package Name="AltMixer" Manufacturer="Tom M0LTE" Version="$(var.ProductVersion)"
           UpgradeCode="478e9713-fca0-43bf-9ca7-2ed2ab48e3d7" Scope="perMachine" Compressed="yes">
    <SummaryInformation Description="AltMixer: desired-state audio mixer for Windows" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of AltMixer is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/M0LTE/altmixer" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/M0LTE/altmixer/issues" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AltMixer">
        <Component Id="App">
          <File Id="AltMixerExe" Source="$(var.PublishDir)AltMixer.exe" KeyPath="yes">
            <Shortcut Id="AltMixerShortcut" Directory="ProgramMenuFolder" Name="AltMixer"
                      Description="Desired-state audio mixer" WorkingDirectory="INSTALLFOLDER" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
