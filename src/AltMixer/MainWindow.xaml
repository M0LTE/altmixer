<Window x:Class="AltMixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AltMixer.ViewModels"
        xmlns:local="clr-namespace:AltMixer"
        Title="AltMixer" Width="660" Height="880" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>

        <!-- Drift marker: warning + Restore + Accept. Bound to a SettingViewModel. -->
        <DataTemplate x:Key="DriftMarker" DataType="vm:SettingViewModel">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDrifted, Converter={StaticResource Visible}}">
                    <TextBlock x:Name="Icon" Text="&#xE7BA;" Style="{StaticResource Warn}" ToolTip="{Binding DriftText}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding RestoreCommand}" ToolTip="Restore what you set"
                            AutomationProperties.Name="Restore" AutomationProperties.AutomationId="{Binding Id, StringFormat=restore:{0}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE73E;" Command="{Binding AcceptCommand}" ToolTip="Keep the new value"
                            AutomationProperties.Name="Keep new value" AutomationProperties.AutomationId="{Binding Id, StringFormat=accept:{0}}" />
                </StackPanel>
                <TextBlock Text="&#xE946;" Style="{StaticResource Warn}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding IsUnavailable, Converter={StaticResource Visible}}" ToolTip="{Binding DriftText}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFighting}" Value="True">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Setting rows, one template per kind. Columns: label | control | value | drift | lock -->
        <DataTemplate x:Key="LevelRow" DataType="vm:SettingViewModel">
            <StackPanel>
                <Grid MinHeight="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Slider Grid.Column="1" AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Id, StringFormat=value:{0}}" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Number}" VerticalAlignment="Center"
                            SmallChange="{Binding SmallChange}" LargeChange="{Binding LargeChange}" IsMoveToPointEnabled="True"
                            local:SliderWheel.Enabled="True" IsEnabled="{Binding IsFixed, Converter={x:Static local:Not.Instance}}" />
                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0" />
                    <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource DriftMarker}" />
                    <ToggleButton Grid.Column="4" Style="{StaticResource LockToggle}" IsChecked="{Binding IsLocked}" AutomationProperties.Name="Lock" AutomationProperties.AutomationId="{Binding Id, StringFormat=lock:{0}}" />
                </Grid>
                <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,40,6"
                           Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ToggleRow" DataType="vm:SettingViewModel">
            <Grid MinHeight="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <CheckBox Grid.Column="1" IsChecked="{Binding Flag}" AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Id, StringFormat=value:{0}}" VerticalAlignment="Center" MinWidth="0" Margin="8,0,0,0" />
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource DriftMarker}" />
                <ToggleButton Grid.Column="3" Style="{StaticResource LockToggle}" IsChecked="{Binding IsLocked}" AutomationProperties.Name="Lock" AutomationProperties.AutomationId="{Binding Id, StringFormat=lock:{0}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceRow" DataType="vm:SettingViewModel">
            <Grid MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Id, StringFormat=value:{0}}" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Id"
                          SelectedValue="{Binding ChoiceId}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,2" />
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource DriftMarker}" />
                <ToggleButton Grid.Column="3" Style="{StaticResource LockToggle}" IsChecked="{Binding IsLocked}" AutomationProperties.Name="Lock" AutomationProperties.AutomationId="{Binding Id, StringFormat=lock:{0}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OpaqueRow" DataType="vm:SettingViewModel">
            <Grid MinHeight="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ValueText}" VerticalAlignment="Center" Style="{StaticResource Dim}" FontSize="14" />
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource DriftMarker}" />
                <ToggleButton Grid.Column="3" Style="{StaticResource LockToggle}" IsChecked="{Binding IsLocked}" AutomationProperties.Name="Lock" AutomationProperties.AutomationId="{Binding Id, StringFormat=lock:{0}}" />
            </Grid>
        </DataTemplate>

        <local:SettingTemplateSelector x:Key="RowSelector"
            Level="{StaticResource LevelRow}" Toggle="{StaticResource ToggleRow}"
            Choice="{StaticResource ChoiceRow}" Opaque="{StaticResource OpaqueRow}" />

        <!-- Card header: level slider + mute + one shared lock/drift. Bound to a GroupViewModel. -->
        <DataTemplate x:Key="HeaderControls" DataType="vm:GroupViewModel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="170" /><ColumnDefinition Width="64" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Mute.Flag}" AutomationProperties.Name="Mute" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding Mute, Converter={x:Static local:NotNullVisible.Instance}}" />
                <Slider Grid.Column="1" Minimum="{Binding Level.Min}" Maximum="{Binding Level.Max}" Value="{Binding Level.Number}"
                        SmallChange="{Binding Level.SmallChange}" LargeChange="{Binding Level.LargeChange}" IsMoveToPointEnabled="True"
                        local:SliderWheel.Enabled="True" VerticalAlignment="Center" IsEnabled="{Binding Level.IsFixed, Converter={x:Static local:Not.Instance}}" />
                <TextBlock Grid.Column="2" Text="{Binding Level.ValueText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding HeaderDrifted, Converter={StaticResource Visible}}">
                    <TextBlock x:Name="Icon" Text="&#xE7BA;" Style="{StaticResource Warn}" ToolTip="{Binding HeaderDriftText}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding HeaderRestoreCommand}" ToolTip="Restore what you set"
                            AutomationProperties.Name="Restore" AutomationProperties.AutomationId="{Binding Id, StringFormat=restore:{0}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE73E;" Command="{Binding HeaderAcceptCommand}" ToolTip="Keep the new value"
                            AutomationProperties.Name="Keep new value" AutomationProperties.AutomationId="{Binding Id, StringFormat=accept:{0}}" />
                </StackPanel>
                <ToggleButton Grid.Column="4" Style="{StaticResource LockToggle}" IsChecked="{Binding HeaderLocked}" AutomationProperties.Name="Lock volume" AutomationProperties.AutomationId="{Binding Id, StringFormat=lock:{0}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HeaderFighting}" Value="True">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DeviceCard" DataType="vm:DeviceViewModel">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Style="{StaticResource IconToggle}" Background="Transparent" BorderThickness="0" FontSize="11"
                                      IsChecked="{Binding IsExpanded, Mode=OneWay}" Click="Collapse_Click" ToolTip="Show or hide details">
                            <ToggleButton.Content>
                                <TextBlock x:Name="Chevron" Text="&#xE76C;" />
                            </ToggleButton.Content>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                            <TextBlock x:Name="DeviceName" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" Visibility="{Binding HasSubtitle, Converter={StaticResource Visible}}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding BodyDriftText}" Style="{StaticResource Dim}" Foreground="{DynamicResource SystemFillColorCautionBrush}" x:Name="BodyDrift" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource HeaderControls}"
                                          Visibility="{Binding HasLevel, Converter={StaticResource Visible}}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding IsDisabled, Converter={StaticResource Visible}}">
                            <TextBlock Text="Enabled" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Dim}" />
                            <CheckBox IsChecked="{Binding Enabled.Flag}" VerticalAlignment="Center" MinWidth="0" />
                            <ContentPresenter Content="{Binding Enabled}" ContentTemplate="{StaticResource DriftMarker}" />
                            <ToggleButton Style="{StaticResource LockToggle}" IsChecked="{Binding Enabled.IsLocked}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Level.Note}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="28,0,40,6"
                               Visibility="{Binding Level.HasNote, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
                    <ItemsControl ItemsSource="{Binding Body}" ItemTemplateSelector="{StaticResource RowSelector}" Margin="28,0,0,6"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}" Focusable="False" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCollapsed}" Value="True" />
                        <Condition Binding="{Binding BodyDriftCount, Converter={x:Static local:Positive.Instance}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="BodyDrift" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter TargetName="DeviceName" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AppCard" DataType="vm:AppViewModel">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="4,0,8,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" Visibility="{Binding HasSubtitle, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource HeaderControls}"
                                          Visibility="{Binding HasLevel, Converter={StaticResource Visible}}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Body}" ItemTemplateSelector="{StaticResource RowSelector}" Margin="4,0,0,4" Focusable="False" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE73E;" />
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDrift}" Value="True">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Restore all" Command="{Binding RestoreAllCommand}" Margin="8,0"
                        Visibility="{Binding HasDrift, Converter={StaticResource Visible}}" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE712;" FontSize="16" Click="Menu_Click" ToolTip="Menu">
                    <Button.ContextMenu>
                        <!-- Set the font explicitly: the menu would otherwise inherit the icon font from its button. -->
                        <ContextMenu FontFamily="{x:Static SystemFonts.MessageFontFamily}">
                            <MenuItem x:Name="StartAtLoginItem" Header="Start at login" IsCheckable="True" Click="StartAtLogin_Click" />
                            <MenuItem Header="Open settings folder" Click="OpenFolder_Click" />
                            <Separator />
                            <MenuItem Header="Exit AltMixer" Click="Exit_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="16,6" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                Visibility="{Binding HasError, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding LastError, StringFormat=Last change failed: {0}}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,16">
                <ItemsControl ItemsSource="{Binding AdoptOffers}" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:AdoptViewModel">
                            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Use previous settings" Command="{Binding AdoptCommand}" Margin="8,0,4,0" />
                                        <Button Content="Treat as new" Command="{Binding DeclineCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Default devices" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Defaults}" ItemTemplateSelector="{StaticResource RowSelector}" Focusable="False" />
                </Border>

                <TextBlock Text="Output devices" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource DeviceCard}" Focusable="False" />

                <TextBlock Text="Input devices" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource DeviceCard}" Focusable="False" />

                <TextBlock Text="Applications" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppCard}" Focusable="False" />

                <TextBlock Text="System" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding SystemSettings}" ItemTemplateSelector="{StaticResource RowSelector}" Focusable="False" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
